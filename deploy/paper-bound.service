[Unit]
Description=Paper-bound reading notes
After=network.target

[Service]
Type=simple
User=paper-bound
Group=paper-bound
WorkingDirectory=/opt/paper-bound
Environment=NOTES_HOST=0.0.0.0
Environment=NOTES_PORT=8080
Environment=NOTES_DATA_DIR=/var/lib/paper-bound
Environment=NOTES_SECURE_COOKIES=0
ExecStart=/bin/sh /opt/paper-bound/start.sh
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paper-bound

[Install]
WantedBy=multi-user.target
